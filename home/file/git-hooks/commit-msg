#!/usr/bin/env bash
#
# Global commit-msg hook -- mechanical validation of commit messages.
# Canonical source for these rules: ~/.claude/skills/commit-conventions-g/SKILL.md
#
# Deployed to ~/.config/git/hooks/commit-msg via home-manager.
# If a repo-local .git/hooks/commit-msg exists, it is chained after this hook.

set -euo pipefail

msg_file="$1"
msg=$(cat "$msg_file")
subject=$(head -1 "$msg_file")

errors=()

# --- Strip IDE-injected AI trailers (Cursor, Copilot, etc.) ---
perl -i -ne 'print unless /^Co-authored-by:\s*(cursor|copilot|ai)/i || /^(Generated by|AI-generated)/i' "$msg_file"
msg=$(cat "$msg_file")
subject=$(head -1 "$msg_file")

# --- Subject line length (git-generated subjects are exempt) ---
if ! [[ "$subject" =~ ^(fixup|squash|amend)!\ |^Merge\ |^Revert\ \" ]] && [ "${#subject}" -gt 50 ]; then
  errors+=("Subject line exceeds 50 characters (currently ${#subject}).")
fi

# --- Body wrap: 72 columns, except URLs, indented code and comments ---
line_no=0
while IFS= read -r line; do
  line_no=$((line_no + 1))
  [ "$line_no" -eq 1 ] && continue
  [[ "$line" == "# ------------------------ >8"* ]] && break
  [[ "$line" == "#"* || "$line" == *"://"* || "$line" == "    "* || "$line" == $'\t'* ]] && continue
  if [ "${#line}" -gt 72 ]; then
    errors+=("Body line $line_no exceeds 72 characters (currently ${#line}).")
  fi
done < "$msg_file"

# --- Report errors ---
if [ ${#errors[@]} -gt 0 ]; then
  echo ""
  echo "commit-msg hook: commit blocked."
  echo ""
  for e in "${errors[@]}"; do
    echo "  - $e"
  done
  echo ""
  echo "Fix the message and try again."
  exit 1
fi

# --- Chain to repo-local hook if present ---
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$repo_root" ] && [ -x "$repo_root/.git/hooks/commit-msg" ]; then
  exec "$repo_root/.git/hooks/commit-msg" "$@"
fi

exit 0
